{
  "name": "dsh-line-puppy-theme",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "线条小狗情侣主题：陈瓜瓜 × 陈西西，奶油白、淡粉与奶黄色的贴贴日常。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-theme",
    "line-puppy",
    "线条小狗"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "main": "./lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "static",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node tests/smoke.mjs"
  }
}
